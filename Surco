name: Build Surco
on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  android:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: '17' }
      - uses: subosito/flutter-action@v2
        with: { channel: stable, cache: true }
      - run: flutter create . --project-name surco --org com.tuempresa --platforms=android
      - run: git checkout -- lib pubspec.yaml
      - run: python3 tools/patch_native.py
      - run: flutter pub get
      - run: flutter build apk --release
      - uses: actions/upload-artifact@v4
        with: { name: Surco-Android-APK, path: build/app/outputs/flutter-apk/app-release.apk }

  windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with: { channel: stable, cache: true }
      - run: flutter create . --project-name surco --org com.tuempresa --platforms=windows
      - run: git checkout -- lib pubspec.yaml
      - run: flutter pub get
      - run: flutter build windows --release
      - run: Compress-Archive -Path build\windows\x64\runner\Release\* -DestinationPath Surco-Windows-Portable.zip
      - uses: actions/upload-artifact@v4
        with: { name: Surco-Windows-Portable, path: Surco-Windows-Portable.zip }

  macos:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with: { channel: stable, cache: true }
      - run: flutter create . --project-name surco --org com.tuempresa --platforms=macos
      - run: git checkout -- lib pubspec.yaml
      - run: python3 tools/patch_native.py
      - run: flutter pub get
      - run: flutter build macos --release
      - run: ditto -c -k --keepParent build/macos/Build/Products/Release/surco.app Surco-macOS.zip
      - uses: actions/upload-artifact@v4
        with: { name: Surco-macOS, path: Surco-macOS.zip }

  ios:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with: { channel: stable, cache: true }
      - run: flutter create . --project-name surco --org com.tuempresa --platforms=ios
      - run: git checkout -- lib pubspec.yaml
      - run: flutter pub get
      - run: flutter build ios --release --no-codesign
      - run: |
          mkdir Payload
          cp -r build/ios/iphoneos/Runner.app Payload/
          zip -r Surco-iOS-unsigned.ipa Payload
      - uses: actions/upload-artifact@v4
        with: { name: Surco-iOS-unsigned-IPA, path: Surco-iOS-unsigned.ipa }
